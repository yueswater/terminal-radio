/* Layout of the radio terminal UI. Colors come from the themes file. */

Screen {
    background: $background;
}

#tabs {
    height: 1fr;
}

Tabs {
    height: 1;
    background: $surface;
}

Tab {
    text-style: bold;
}

Tab.-active {
    background: $block-cursor-background;
    color: $block-cursor-foreground;
}

Tabs Underline {
    display: none;
}

TabPane {
    padding: 0 1;
}

.centered-table-page,
#tab-statistics,
.centered-table-shell {
    overflow: hidden;
}

#statistics {
    height: 1fr;
    padding: 1;
    overflow-y: auto;
    scrollbar-size-vertical: 0;
}

#statistics-report {
    width: 1fr;
    height: auto;
    min-height: 100%;
    text-wrap: nowrap;
}

.table-action-spacer,
.table-action-footer-spacer,
#history-actions, #settings-actions {
    height: 1;
}

.centered-table-shell {
    height: 1fr;
    align: center middle;
}

#history-actions, #settings-actions {
    align-horizontal: right;
}

#clear-history, #export-history, #reset-settings {
    min-width: 18;
}

.main-station-table, #history, #settings {
    height: 25;
    max-height: 100%;
    overflow-y: auto;
}

Button:focus {
    text-style: bold;
}

/* Columns may run past the right edge. The mouse scrolls to them, the arrow
   keys never do, and the bar is hidden so it cannot be read as a gauge. */
DataTable {
    height: 1fr;
    background: $background;
    overflow-x: auto;
    scrollbar-size-horizontal: 0;
}

DataTable > .datatable--header {
    background: $surface;
    color: $text-muted;
    text-style: none;
}

DataTable > .datatable--cursor {
    background: $primary 35%;
    text-style: bold;
}

#now-playing {
    height: 3;
    padding: 0 2;
    background: $surface;
    border-top: solid $panel;
    color: $text-muted;
}

#np-top, #np-bottom {
    height: 1;
}

#np-state {
    width: 11;
    text-style: bold;
    color: $text-disabled;
    pointer: pointer;
}

#np-dial {
    width: 12;
    color: $accent;
    text-style: bold;
}

#np-station {
    width: 1fr;
    color: $foreground;
    text-style: bold;
}

#np-timer {
    width: 18;
    text-align: right;
}

#np-program {
    width: 1fr;
}

#np-device {
    width: 17;
    text-align: right;
    color: $text-muted;
}

#np-sleep {
    width: 18;
    text-align: right;
    color: $warning;
}

#np-volume {
    width: 22;
    text-align: right;
}

#now-playing.playing #np-state {
    color: $success;
}

#now-playing.paused #np-state {
    color: $warning;
}

#now-playing.reconnecting #np-state {
    color: $warning;
}

ConfirmationScreen {
    align: center middle;
    background: $background 70%;
}

SleepTimerScreen {
    align: center middle;
    background: $background 70%;
}

ShortcutHelpScreen {
    align: center middle;
    background: $background 70%;
}

#shortcut-dialog {
    width: 58;
    max-width: 92%;
    height: auto;
    max-height: 94%;
    padding: 1 3;
    background: $surface;
    border: round $primary;
}

#shortcut-title {
    height: 1;
    text-align: center;
    text-style: bold;
    margin-bottom: 1;
}

#shortcut-content {
    height: auto;
}

#shortcut-close-hint {
    height: 1;
    margin-top: 1;
    text-align: center;
    color: $text-muted;
}

StationSearchScreen {
    align: center middle;
    background: $background 70%;
}

CustomStationManagerScreen,
CustomStationFormScreen {
    align: center middle;
    background: $background 70%;
}

#custom-station-manager {
    width: 90%;
    height: 80%;
    padding: 1 2;
    background: $surface;
    border: round $primary;
}

#custom-manager-title, #custom-form-title {
    height: 1;
    text-style: bold;
    text-align: center;
}

#custom-station-list {
    height: 1fr;
    margin: 1 0;
}

#custom-manager-actions, #custom-form-actions {
    height: 3;
    align-horizontal: center;
}

#custom-manager-actions Button,
#custom-form-actions Button {
    min-width: 10;
    margin: 0 1;
}

#custom-station-form {
    width: 72;
    max-width: 92%;
    height: auto;
    max-height: 95%;
    padding: 1 2;
    background: $surface;
    border: round $primary;
}

.custom-form-label {
    height: 1;
    color: $text-muted;
    margin-top: 1;
}

#custom-form-error {
    height: 1;
    color: $error;
    text-align: center;
}

#station-search-dialog {
    width: 90%;
    height: 80%;
    padding: 1 2;
    background: $surface;
    border: round $primary;
}

#station-search-title {
    height: 1;
    text-style: bold;
    text-align: center;
}

#station-search-input {
    margin: 1 0;
}

#station-search-results {
    height: 1fr;
}

#station-search-hint {
    height: 1;
    color: $text-muted;
    text-align: center;
}

#sleep-dialog {
    width: 64;
    max-width: 90%;
    height: auto;
    padding: 1 2;
    background: $surface;
    border: round $primary;
}

#sleep-title {
    text-style: bold;
    text-align: center;
}

#sleep-current {
    color: $text-muted;
    text-align: center;
    margin-bottom: 1;
}

#sleep-presets, #sleep-actions {
    height: 3;
    align-horizontal: center;
}

#sleep-presets Button, #sleep-actions Button {
    min-width: 10;
    margin: 0 1;
}

#sleep-custom {
    margin-top: 1;
}

#sleep-error {
    height: 1;
    color: $error;
    text-align: center;
}

#confirm-dialog {
    width: 64;
    max-width: 90%;
    height: auto;
    padding: 1 2;
    background: $surface;
    border: round $primary;
}

#confirm-question {
    width: 100%;
    height: auto;
    margin-bottom: 1;
    text-align: center;
    text-style: bold;
}

#confirm-actions {
    width: 100%;
    height: 3;
    align-horizontal: center;
}

#confirm-actions Button {
    min-width: 12;
    margin: 0 1;
}

/* About page. Centred across, but starting at the top because it scrolls. */
AboutPanel {
    height: 1fr;
    align-horizontal: center;
    padding: 1 2;
    scrollbar-size-vertical: 1;
}

#about-title {
    width: 100%;
    margin-top: 1;
    text-align: center;
    text-style: bold;
    color: $accent;
}

#about-summary {
    width: 100%;
    text-align: center;
    color: $foreground;
}

#about-copyright, #about-home {
    width: 100%;
    text-align: center;
    color: $text-muted;
}

.about-heading {
    width: 100%;
    margin-top: 1;
    text-align: center;
    text-style: bold;
    color: $foreground;
}

.about-credit {
    width: 100%;
    text-align: center;
    color: $text-muted;
}

/* Notifications sit in the top right corner instead of the default bottom. */
ToastRack {
    dock: top;
    align: right top;
    margin-top: 1;
    margin-bottom: 0;
}

/* Themes page. Each card paints itself with the palette it previews. The
   vertical margin matches the inset the other tabs get from their shell. */
ThemeGallery {
    height: 1fr;
    margin: 2 0;
    background: $background;
    border: none;
}

ThemeCard {
    height: 4;
    padding: 0 1;
    margin-bottom: 1;
    border-left: thick $panel;
}

ThemeCard.-highlight {
    border-left: thick $primary;
}

.theme-name {
    text-style: bold;
    padding: 0 1;
}

.theme-swatches {
    height: 1;
    padding-left: 1;
}

.swatch {
    width: 9;
    height: 1;
    text-align: center;
    text-style: bold;
}

/* Key hints, drawn here instead of by Footer so they follow the language. */
#hints {
    height: 1;
    padding: 0 2;
    background: $surface;
    color: $text-muted;
}

/* Home page. Everything is centred and follows the size of the terminal. */
/* The block is centred in both directions, and still scrolls if it outgrows
   a short terminal. */
HomePanel {
    height: 1fr;
    align: center middle;
    padding: 1 2;
    scrollbar-size-vertical: 1;
}

.logo-line {
    width: 100%;
    text-align: center;
    color: $primary;
    text-style: bold;
}

#home-tagline {
    width: 100%;
    margin-top: 1;
    text-align: center;
    text-style: bold;
    color: $foreground;
}

#home-hint {
    width: 100%;
    margin-top: 1;
    text-align: center;
    color: $text-muted;
}

/* Farewell screen. */
GoodbyeScreen {
    align: center middle;
    background: $background;
}

#goodbye {
    width: 100%;
    height: auto;
    align: center middle;
}

#goodbye-logo {
    margin-bottom: 1;
}

#goodbye-title {
    width: 100%;
    text-align: center;
    text-style: bold;
    color: $primary;
}

#goodbye-listened {
    width: 100%;
    text-align: center;
    color: $text-muted;
}

/* Size classes. A wider terminal gets more air and a larger word mark. */
Screen.-wide TabPane {
    padding: 1 3;
}

Screen.-wide #tab-history,
Screen.-wide #tab-settings {
    padding: 0 3;
}

Screen.-wide #now-playing {
    height: 4;
    padding: 1 3;
}

Screen.-wide HomePanel,
Screen.-wide AboutPanel {
    padding: 2 4;
}

Screen.-compact #np-dial {
    width: 9;
}

Screen.-compact #np-device {
    display: none;
}

Screen.-compact #hints {
    text-align: center;
}

LogoBlock {
    width: 100%;
    height: auto;
}

/* Export and import pickers. */
ExportScreen, ImportScreen {
    align: center middle;
}

#export, #import {
    width: 64;
    height: auto;
    padding: 1 2;
    background: $surface;
    border: round $primary;
}

#export-title, #import-title {
    text-style: bold;
    color: $foreground;
}

#export-filename {
    color: $accent;
    margin-bottom: 1;
}

#export-list, #import-list {
    height: auto;
    max-height: 12;
    margin-top: 1;
    background: $surface;
    border: none;
}

#import-empty {
    margin-top: 1;
    color: $warning;
}

#export-hint, #import-hint {
    margin-top: 1;
    color: $text-muted;
}
